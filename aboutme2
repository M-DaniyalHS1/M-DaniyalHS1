<svg xmlns="http://www.w3.org/2000/svg"
     width="1200"
     height="460"
     viewBox="0 0 1200 460">

  <title>About me</title>
  <desc>Full-stack development and AI interests, with an animated portrait.</desc>
  <defs>
    <clipPath id="portraitCrop"><circle cx="1025" cy="245" r="145"/></clipPath>
    <filter id="portraitGlow" x="-25%" y="-25%" width="150%" height="150%">
      <feGaussianBlur stdDeviation="6"/>
    </filter>
    <linearGradient id="blueGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#22d3ee"/>
      <stop offset="60%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>

  <!-- ================= TITLE ================= -->

  <text x="35" y="48"
        font-family="Arial, Helvetica, sans-serif"
        font-size="34"
        font-weight="700"
        fill="url(#blueGradient)">
    ABOUT ME
  </text>

  <!-- Header circuit -->

  <path d="M225 36 H400 L420 22 H545"
        fill="none"
        stroke="url(#blueGradient)"
        stroke-width="2"/>

  <circle cx="550" cy="22" r="4" fill="#22d3ee">
    <animate attributeName="opacity"
             values=".3;1;.3"
             dur="2s"
             repeatCount="indefinite"/>
  </circle>


  <!-- ================= TEXT ================= -->

  <g font-family="Arial, Helvetica, sans-serif"
     font-size="18"
     fill="#c9d1d9">

    <text x="35" y="95">
      🚀 Building modern
      <tspan fill="#38bdf8" font-weight="700">
        Full-Stack Web Applications
      </tspan>

      <animate attributeName="opacity"
               values="0;1;1"
               keyTimes="0;.08;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="127">
      🤖 Developing
      <tspan fill="#38bdf8" font-weight="700">
        Agentic AI systems and AI-powered applications
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.04;.12;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="159">
      🐍 Working with
      <tspan fill="#38bdf8" font-weight="700">
        Python, FastAPI &amp; Django
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.08;.16;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="191">
      ⚛ Building interactive frontends with
      <tspan fill="#38bdf8" font-weight="700">
        React &amp; JavaScript
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.12;.20;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="223">
      🎨 Creating responsive interfaces using
      <tspan fill="#38bdf8" font-weight="700">
        HTML, CSS &amp; Tailwind CSS
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.16;.24;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="255">
      🗄 Working with
      <tspan fill="#38bdf8" font-weight="700">
        PostgreSQL, Supabase, SQLite &amp; SQLAlchemy
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.20;.28;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="287">
      🔐 Authentication using
      <tspan fill="#38bdf8" font-weight="700">
        JWT &amp; OAuth2
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.24;.32;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="319">
      🔗 Designing and integrating
      <tspan fill="#38bdf8" font-weight="700">
        REST APIs
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.28;.36;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="351">
      ⚙ Automating workflows using
      <tspan fill="#38bdf8" font-weight="700">
        n8n
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.32;.40;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="383">
      🧠 Exploring
      <tspan fill="#38bdf8" font-weight="700">
        LLMs, AI Agents, tool calling and AI automation
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.36;.44;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>


    <text x="35" y="415">
      ☁ Learning modern
      <tspan fill="#38bdf8" font-weight="700">
        cloud deployment and production workflows
      </tspan>

      <animate attributeName="opacity"
               values="0;0;1;1"
               keyTimes="0;.40;.48;1"
               dur="8s"
               repeatCount="indefinite"/>
    </text>

  </g>


  <!-- Embedded original portrait; all motion is native SVG animation. -->
  <g id="portrait">
    <animateTransform attributeName="transform" type="translate"
      values="0 0;0 -5;0 0" dur="6s" repeatCount="indefinite"
      calcMode="spline" keyTimes="0;.5;1" keySplines=".42 0 .58 1;.42 0 .58 1"/>
    <circle cx="1025" cy="245" r="152" fill="none"
      stroke="url(#blueGradient)" stroke-width="10" opacity=".3" filter="url(#portraitGlow)">
      <animate attributeName="opacity" values=".2;.45;.2" dur="4s" repeatCount="indefinite"/>
    </circle>
    <image x="880" y="100" width="290" height="290"
      preserveAspectRatio="xMidYMid slice" clip-path="url(#portraitCrop)"
      href="data:image/png;base64,"/>
    <circle cx="1025" cy="245" r="152" fill="none"
      stroke="url(#blueGradient)" stroke-width="3" opacity=".8">
      <animate attributeName="opacity" values=".6;1;.6" dur="4s" repeatCount="indefinite"/>
    </circle>
  </g>
</svg>
